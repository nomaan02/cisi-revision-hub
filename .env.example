# CISI Revision Hub settings
# 1. Copy this file and name the copy ".env" (same folder as app.py).
# 2. Fill in the values you want. Everything is optional.

# Folder holding YOUR study materials (topics/, question-bank/, reference/).
# Leave blank to open the built-in sample content.
# Windows example: MATERIALS_DIR=C:\Users\you\Documents\cisi-materials
MATERIALS_DIR=

# Where your progress, flags and notes are saved (default: progress.json next to app.py)
# PROGRESS_FILE=

# Optional "party mode": a folder of your own .gif files
# REWARD_GIFS_DIR=
